# Copia este archivo a .env.dev para desarrollo local. Nunca subas credenciales.
APP_ENV=dev

# Usa DATABASE_URL O el bloque PG*, nunca ambos.
PGHOST=your-dev-postgres-host
PGDATABASE=db-eterlotto-dev
PGUSER=your-dev-user
PGPASSWORD=replace-me
PGPORT=5432
PGSSLMODE=require

# Debe aparecer en el host, base o usuario configurado.
DATABASE_ENV_MARKER=dev

# Reservado para cuando los modelos se versionen como artefactos persistentes.
MODEL_ROOT=modelos_ML/models
# MODEL_VERSION=
