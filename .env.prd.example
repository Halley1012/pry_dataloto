# Copia este archivo a .env.prd solo en el host de producción. Nunca lo subas
# con valores reales ni ejecutes PRD sin APP_ENV=prd explícito.
APP_ENV=prd

# Usa DATABASE_URL O el bloque PG*, nunca ambos.
PGHOST=your-prd-postgres-host
PGDATABASE=db-eterlotto-prd
PGUSER=your-prd-user
PGPASSWORD=replace-me
PGPORT=5432
PGSSLMODE=require

# Obligatorio en PRD: el valor debe aparecer en host, base o usuario.
DATABASE_ENV_MARKER=prd

MODEL_ROOT=modelos_ML/models
# MODEL_VERSION=
