APP_ENV=dev

# Base de datos: usa DATABASE_URL O las variables PG*, nunca ambas.
PGHOST=YOUR_SUPABASE_HOST
PGDATABASE=postgres
PGUSER=YOUR_SUPABASE_USER
PGPASSWORD=CHANGE_ME
PGPORT=5432
PGSSLMODE=require

# Marcador de seguridad. En PRD es obligatorio y debe aparecer en el host,
# nombre de base o usuario (por ejemplo el project ref de Supabase).
DATABASE_ENV_MARKER=YOUR_SUPABASE_PROJECT_REF

# Alertas de Airflow
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=YOUR_EMAIL
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=YOUR_EMAIL
SMTP_TO=YOUR_EMAIL

# Firebase (archivo local/secret; no versionar)
FIREBASE_CREDENTIALS_FILE=.secrets/firebase_credentials.json

# Opcionales
# ETERLOTTO_VENV_ROOT=.venv_airflow
# MODEL_ROOT=models
# MODEL_VERSION=v1
